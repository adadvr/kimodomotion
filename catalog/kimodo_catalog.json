{
  "version": "2.0",
  "notes": "Catalogo base redistribuible para el plugin. Los prompts estan escritos en el estilo declarativo corto que Kimodo (BONES-SEED / SOMA) espera. NADA de 'seamless loop', 'in place' ni 'starts and ends neutral' en el texto: eso se resuelve con constraints y postproceso, no con palabras.",
  "defaults": {
    "model": "Kimodo-SOMA-RP-v1",
    "fps": 30,
    "diffusion_steps": 100,
    "cfg_type": "separated",
    "cfg_weight": [2.5, 1.5],
    "num_samples": 4,
    "base_seed": 20260813,
    "bvh": true,
    "bvh_standard_tpose": true
  },
  "root_policies": {
    "strip_xz": "Generar con desplazamiento libre (mejor calidad) y separar despues: BVH in-place + curva de root en JSON. Para loops de locomocion.",
    "pin_origin": "Constraint root2d con la trayectoria clavada en (0,0) para que el modelo NO camine. Para idles, upper actions y reacciones.",
    "keep": "Mantener el desplazamiento horneado en el clip. Para transiciones one-shot donde el desplazamiento es parte de la accion."
  },
